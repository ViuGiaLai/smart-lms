# ============================================================================
# Smart LMS - Mau bien moi truong cho docker compose.
# Sao chep file nay thanh `.env` (cung thu muc voi docker-compose.yml) roi dien
# gia tri thuc truoc khi chay: docker compose up -d
# ============================================================================

# --- Bao mat (BAT BUOC doi khi trien khai thuc te) ---
# Sinh chuoi ngau nhien:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
NEXTAUTH_SECRET=

# --- Database (doi mat khau truoc khi trien khai thuc te) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=smart_lms

# --- AI (Google Gemini) ---
# Lay API key mien phi tai: https://aistudio.google.com/app/apikey
# (AI Service doc ca GOOGLE_API_KEY lan GEMINI_API_KEY)
GEMINI_API_KEY=
