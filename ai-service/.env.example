# ===== Smart LMS - AI Service Environment Variables =====
# Copy file nay thanh `.env` trong thu muc ai-service roi dien gia tri thuc te.
#   Copy-Item .env.example .env
# Khong commit file `.env` len git.

# ---- Google Gemini ----
# Lay API key mien phi tai: https://aistudio.google.com/app/apikey
# AI Service doc GOOGLE_API_KEY; docker compose truyen GEMINI_API_KEY (duoc fallback tu dong).
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Danh sach model du phong (JSON array). De trong = dung mac dinh trong code.
# GEMINI_FALLBACK_MODELS=["gemini-flash-latest","gemini-flash-lite-latest","gemini-2.5-flash-lite","gemini-pro-latest"]
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ---- OpenAI (fallback) ----
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Groq (fallback khi Gemini het quota) ----
# Lay API key tai: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- AI Provider Priority ----
# AI_PROVIDER: "gemini" hoac "openai"
# EMBEDDING_PROVIDER: "gemini" | "openai" | "sentence-transformers"
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# ---- Database (PostgreSQL + pgvector) ----
# Vi du Supabase:
#   postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/smart_lms
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/smart_lms

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Bao mat noi bo ----
# Khoa chia se giua Backend va AI Service (header X-Internal-Api-Key).
# De trong = tat kiem tra (chi nen dung khi dev cuc bo).
INTERNAL_API_KEY=

# ---- App Settings ----
APP_NAME=Smart LMS AI Service
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO
PORT=8001

# ---- CORS ----
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- Document Processing ----
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_QUERY=5

# ---- RAG Settings ----
SIMILARITY_THRESHOLD=0.50
MAX_CONTEXT_TOKENS=8000

# ---- Whisper Settings ----
WHISPER_MODEL=base
# Chon: tiny, base, small, medium, large
