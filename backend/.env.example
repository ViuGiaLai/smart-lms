# ===== Smart LMS - Backend Environment Variables =====
# Copy file nay thanh `.env` trong thu muc backend roi dien gia tri thuc te.
#   Copy-Item .env.example .env
# Khong commit file `.env` len git.

# ── Application ──
APP_NAME="Smart LMS"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
# Đăng nhập nhanh theo vai trò (không cần mật khẩu) chỉ dùng cho demo nội bộ.
# Production BẮT BUỘC để false.
ALLOW_DEMO_LOGIN=false

# ── Chống brute-force (đếm theo IP, trong bộ nhớ tiến trình) ──
# Mỗi worker đếm riêng: giới hạn thực tế = giá trị × số worker.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5
REFRESH_RATE_LIMIT_PER_MINUTE=30
FORGOT_RATE_LIMIT_PER_MINUTE=5

# ── Quên mật khẩu & gửi email ──
# Dùng để tạo liên kết đặt lại mật khẩu trong email.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# Để trống SMTP_HOST: backend ghi liên kết vào log (chỉ ở môi trường dev).
# Production bắt buộc cấu hình SMTP để người dùng nhận được email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ── API ──
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Database (PostgreSQL + pgvector) ──
# Vi du Supabase:
#   postgresql+asyncpg://postgres.<project-ref>:<password>@<host>:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/smart_lms
DATABASE_ECHO=false
# Tắt pre_ping khi DB ở xa (mỗi lần mượn connection tốn 1 round-trip);
# pool_recycle lo việc loại bỏ connection cũ.
DATABASE_POOL_PRE_PING=false
DATABASE_POOL_RECYCLE=240

# ── Security ──
# BAT BUOC doi khi trien khai thuc te: chuoi ngau nhien >= 32 ky tu.
# Sinh chuoi:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Khoa dung khi chay seed_sync_data.py. Khong commit gia tri that len git.
SEED_SECRET_KEY=
# Mat khau khoi tao cho cac tai khoan seed (chi dung khi tao moi, khong reset
# mat khau cua tai khoan da ton tai).
SEED_MASTER_PASSWORD=

# ── Redis / Celery ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS S3 (media storage) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=smart-lms-media

# ── Cloudinary (ảnh bìa khóa học / thumbnail) ──
# Backend ký yêu cầu tải ảnh phía máy chủ; API secret KHÔNG đặt ở frontend.
# Lấy thông số trong Cloudinary Console → Settings → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smart-lms/courses

# ── AI Service ──
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=120
# Phai TRUNG voi INTERNAL_API_KEY cua ai-service. De trong neu AI Service tat kiem tra.
AI_SERVICE_INTERNAL_KEY=

# ── YouTube Import ─────────────────────────
# YouTube Data API v3 chi de lay metadata (khong tai video, khong tai phu de).
# Bat YOUTUBE_IMPORT_ENABLED=false neu khong dung tinh nang.
YOUTUBE_API_KEY=
YOUTUBE_IMPORT_ENABLED=false
# yt-dlp ho tro lay phu de cong khai khi duoc phep; tat mac dinh.
YOUTUBE_SUBTITLE_ENABLED=false
YOUTUBE_SUBTITLE_TIMEOUT=60
YOUTUBE_SUBTITLE_LANGUAGES=vi,en
YOUTUBE_MAX_ITEMS=200
# Cloudflare R2 (S3-compatible object storage for lesson video/documents)
# R2_PUBLIC_BASE_URL must be your public r2.dev or custom-domain URL; never
# commit the two keys below and never expose them to the browser.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=smart-tutor-ai
R2_PUBLIC_BASE_URL=
