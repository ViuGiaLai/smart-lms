// Module 3: Learning Activity (Ghi danh, Tiến độ, Đánh giá)
// Dán vào https://dbdiagram.io → chụp ảnh cho phần "Hoạt động Học tập"

Table users {
  id    integer      [pk]
  email varchar(255) [not null]
  name  varchar(255) [not null]
}

Table courses {
  id    integer      [pk]
  title varchar(512) [not null]
}

Table lessons {
  id          integer     [pk]
  title       varchar(512)[not null]
  order_index integer     [not null]
  // ── FK ──
  course_id   integer     [not null, ref: > courses.id]
}

Table enrollments {
  id          integer     [pk, increment]
  enrolled_at timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id     integer     [not null, ref: > users.id]
  course_id   integer     [not null, ref: > courses.id]

  indexes {
    (user_id, course_id) [unique, name: 'uq_user_course_enrollment']
  }
}

Table progress {
  id               integer     [pk, increment]
  percent_complete float       [not null, default: 0.0]
  is_completed     boolean     [not null, default: false]
  last_position    integer     [not null, default: 0]
  started_at       timestamptz [not null, default: `now()`]
  completed_at     timestamptz
  updated_at       timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id          integer     [not null, ref: > users.id]
  lesson_id        integer     [not null, ref: > lessons.id]

  indexes {
    (user_id, lesson_id) [unique, name: 'uq_user_lesson_progress']
  }
}

Table course_reviews {
  id         integer     [pk, increment]
  rating     integer     [not null, note: '1–5']
  comment    text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  // ── FK ──
  course_id  integer     [not null, ref: > courses.id]
  user_id    integer     [not null, ref: > users.id]

  indexes {
    (course_id, user_id) [unique, name: 'uq_course_review_user']
  }
}
