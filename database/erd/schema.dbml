// Smart LMS – DBML Schema
// https://dbdiagram.io

Enum userrole {
  student
  instructor
  admin
}

Enum coursestatus {
  draft
  published
  archived
}

Enum discoverystatus {
  pending
  approved
  rejected
  converted
}

// ─────────────────────────────────────────────
Table users {
  id              integer     [pk, increment]
  // ── fields ──
  email           varchar(255)[not null, unique]
  name            varchar(255)[not null]
  hashed_password varchar(255)[not null]
  role            userrole    [not null, default: 'student']
  is_active       boolean     [not null, default: true]
  avatar_url      varchar(512)
  token_version   integer     [not null, default: 0]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
}

// ─────────────────────────────────────────────
Table learning_categories {
  id          integer     [pk, increment]
  // ── fields ──
  name        varchar(255)[not null]
  slug        varchar(255)[not null, unique]
  description text
  icon        varchar(64)
  order_index integer     [not null, default: 0]
  is_active   boolean     [not null, default: true]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
  // ── FK ──
  parent_id   integer     [ref: > learning_categories.id]
}

// ─────────────────────────────────────────────
Table education_levels {
  id          integer     [pk, increment]
  // ── fields ──
  name        varchar(100)[not null]
  code        varchar(50) [not null, unique]
  description text
  order_index integer     [not null, default: 0]
  is_active   boolean     [not null, default: true]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]
}

// ─────────────────────────────────────────────
Table courses {
  id                 integer       [pk, increment]
  // ── fields ──
  title              varchar(512)  [not null]
  slug               varchar(255)  [not null, unique]
  description        text
  price              decimal(12,2) [not null, default: 0.00]
  thumbnail          varchar(512)
  status             coursestatus  [not null, default: 'draft']
  category           varchar(255)
  level              varchar(50)
  grade_label        varchar(100)
  proficiency_level  varchar(50)
  target_audience    varchar(255)
  language           varchar(20)   [default: 'vi']
  outcomes           json
  prerequisites      json
  created_at         timestamptz   [not null, default: `now()`]
  updated_at         timestamptz   [not null, default: `now()`]
  // ── FK ──
  instructor_id      integer       [not null, ref: > users.id]
  category_id        integer       [ref: > learning_categories.id]
  education_level_id integer       [ref: > education_levels.id]
}

// ─────────────────────────────────────────────
Table lessons {
  id                integer      [pk, increment]
  // ── fields ──
  title             varchar(512) [not null]
  description       text
  video_url         varchar(1024)
  duration          integer      [not null, default: 0]
  order_index       integer      [not null, default: 0]
  transcript        text
  resources_url     varchar(1024)
  youtube_video_id  varchar(32)
  subtitle_status   varchar(20)  [not null, default: 'none']
  subtitle_language varchar(16)
  subtitle_srt      text
  subtitle_checksum varchar(64)
  subtitle_error    text
  source_type       varchar(20)  [not null, default: 'manual']
  created_at        timestamptz  [not null, default: `now()`]
  updated_at        timestamptz  [not null, default: `now()`]
  // ── FK ──
  course_id         integer      [not null, ref: > courses.id]
}

// ─────────────────────────────────────────────
Table lesson_materials {
  id            integer       [pk, increment]
  // ── fields ──
  kind          varchar(20)   [not null, note: 'document | video']
  title         varchar(512)  [not null]
  file_url      varchar(1024) [not null]
  storage_key   varchar(1024) [unique]
  mime_type     varchar(255)
  size_bytes    integer
  status        varchar(20)   [not null, default: 'ready']
  error_message varchar(1024)
  created_at    timestamptz   [not null, default: `now()`]
  // ── FK ──
  lesson_id     integer       [not null, ref: > lessons.id]
}

// ─────────────────────────────────────────────
Table enrollments {
  id          integer     [pk, increment]
  // ── fields ──
  enrolled_at timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id     integer     [not null, ref: > users.id]
  course_id   integer     [not null, ref: > courses.id]

  indexes { (user_id, course_id) [unique] }
}

// ─────────────────────────────────────────────
Table progress {
  id               integer     [pk, increment]
  // ── fields ──
  percent_complete float       [not null, default: 0.0]
  is_completed     boolean     [not null, default: false]
  last_position    integer     [not null, default: 0]
  started_at       timestamptz [not null, default: `now()`]
  completed_at     timestamptz
  updated_at       timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id          integer     [not null, ref: > users.id]
  lesson_id        integer     [not null, ref: > lessons.id]

  indexes { (user_id, lesson_id) [unique] }
}

// ─────────────────────────────────────────────
Table quizzes {
  id              integer      [pk, increment]
  // ── fields ──
  title           varchar(512) [not null]
  description     text
  time_limit      integer
  pass_score      float        [not null, default: 0.6]
  is_ai_generated boolean      [not null, default: false]
  created_at      timestamptz  [not null, default: `now()`]
  updated_at      timestamptz  [not null, default: `now()`]
  // ── FK ──
  course_id       integer      [not null, ref: > courses.id]
  lesson_id       integer      [ref: > lessons.id]
}

// ─────────────────────────────────────────────
Table quiz_questions {
  id             integer     [pk, increment]
  // ── fields ──
  question_text  text        [not null]
  options        json        [not null]
  correct_answer varchar(10) [not null]
  explanation    text
  order_index    integer     [not null, default: 0]
  // ── FK ──
  quiz_id        integer     [not null, ref: > quizzes.id]
}

// ─────────────────────────────────────────────
Table quiz_submissions {
  id           integer     [pk, increment]
  // ── fields ──
  answers      json        [not null]
  score        float       [not null, default: 0.0]
  passed       boolean     [not null, default: false]
  time_spent   integer
  submitted_at timestamptz [not null, default: `now()`]
  // ── FK ──
  quiz_id      integer     [not null, ref: > quizzes.id]
  user_id      integer     [not null, ref: > users.id]
}

// ─────────────────────────────────────────────
Table course_reviews {
  id         integer     [pk, increment]
  // ── fields ──
  rating     integer     [not null, note: '1–5']
  comment    text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  // ── FK ──
  course_id  integer     [not null, ref: > courses.id]
  user_id    integer     [not null, ref: > users.id]

  indexes { (course_id, user_id) [unique] }
}

// ─────────────────────────────────────────────
Table chat_messages {
  id         integer     [pk, increment]
  // ── fields ──
  role       varchar(16) [not null, note: 'user | assistant']
  content    text        [not null]
  sources    json
  created_at timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id    integer     [not null, ref: > users.id]
  course_id  integer     [ref: > courses.id]
  lesson_id  integer     [not null, ref: > lessons.id]
}

// ─────────────────────────────────────────────
Table ai_message_feedback {
  id         integer     [pk, increment]
  // ── fields ──
  rating     varchar(8)  [not null, note: 'up | down']
  comment    text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  // ── FK ──
  message_id integer     [not null, ref: > chat_messages.id]
  user_id    integer     [not null, ref: > users.id]

  indexes { (message_id, user_id) [unique] }
}

// ─────────────────────────────────────────────
Table ai_usage_logs {
  id                integer     [pk, increment]
  // ── fields ──
  feature           varchar(32) [not null, note: 'tutor | quiz | grader']
  provider          varchar(32) [not null, default: 'gemini']
  model             varchar(128)
  prompt_tokens     integer     [not null, default: 0]
  completion_tokens integer     [not null, default: 0]
  total_tokens      integer     [not null, default: 0]
  is_estimated      boolean     [not null, default: false]
  user_id           integer     [note: 'soft ref → users.id']
  lesson_id         integer     [note: 'soft ref → lessons.id']
  created_at        timestamptz [not null, default: `now()`]
}

// ─────────────────────────────────────────────
Table essay_gradings {
  id               integer      [pk, increment]
  // ── fields ──
  student_name     varchar(255) [not null]
  student_email    varchar(255)
  question         text
  student_answer   text         [not null]
  reference_answer text
  rubric           json         [not null]
  total_score      float        [not null]
  max_total_score  float        [not null, default: 10.0]
  percentage       float        [not null, default: 0.0]
  grade_level      varchar(8)   [not null, default: 'C']
  criteria_scores  json         [not null]
  overall_feedback text
  strengths        json         [not null]
  improvements     json         [not null]
  provider         varchar(32)  [not null, default: 'gemini']
  model            varchar(128)
  created_at       timestamptz  [not null, default: `now()`]
  // ── FK ──
  instructor_id    integer      [not null, ref: > users.id]
  course_id        integer      [ref: > courses.id]
  lesson_id        integer      [ref: > lessons.id]
}

// ─────────────────────────────────────────────
Table learning_events {
  id               integer     [pk, increment]
  // ── fields ──
  event_type       varchar(40) [not null]
  duration_seconds integer
  metadata         json
  created_at       timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id          integer     [not null, ref: > users.id]
  course_id        integer     [ref: > courses.id]
  lesson_id        integer     [ref: > lessons.id]
}

// ─────────────────────────────────────────────
Table password_reset_tokens {
  id         integer     [pk, increment]
  // ── fields ──
  token_hash varchar(64) [not null, unique]
  expires_at timestamptz [not null]
  used_at    timestamptz
  created_at timestamptz [not null, default: `now()`]
  // ── FK ──
  user_id    integer     [not null, ref: > users.id]
}

// ─────────────────────────────────────────────
Table student_topic_mastery {
  id                    integer      [pk, increment]
  // ── fields ──
  topic_name            varchar(255) [not null]
  mastery_score         float        [not null, default: 0.0]
  attempts_count        integer      [not null, default: 0]
  weak_points           json
  strong_points         json
  recommended_next_step varchar(512)
  updated_at            timestamptz  [not null, default: `now()`]
  // ── FK ──
  user_id               integer      [not null, ref: > users.id]
  course_id             integer      [not null, ref: > courses.id]

  indexes { (user_id, course_id, topic_name) [unique] }
}

// ─────────────────────────────────────────────
Table discovery_jobs {
  id                 integer          [pk, increment]
  // ── fields ──
  topic              varchar(512)     [not null]
  target_level       varchar(100)
  domain_category    varchar(100)
  status             discoverystatus  [not null, default: 'pending']
  summary            text
  proposed_blueprint json
  created_at         timestamptz      [not null, default: `now()`]
  updated_at         timestamptz      [not null, default: `now()`]
  // ── FK ──
  user_id            integer          [not null, ref: > users.id]
}

// ─────────────────────────────────────────────
Table discovery_items {
  id            integer          [pk, increment]
  // ── fields ──
  item_type     varchar(50)      [not null]
  title         varchar(512)     [not null]
  description   text
  source_url    varchar(1024)
  provider_name varchar(255)
  metadata_info json
  order_index   integer          [not null, default: 0]
  status        discoverystatus  [not null, default: 'pending']
  created_at    timestamptz      [not null, default: `now()`]
  // ── FK ──
  job_id        integer          [not null, ref: > discovery_jobs.id]
}
