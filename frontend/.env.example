# =============================================
# Smart LMS Frontend - Environment Variables
# =============================================
# Copy file nay thanh `.env.local` trong thu muc frontend roi dien gia tri thuc te.
#   Copy-Item .env.example .env.local
# Khong commit file `.env.local` len git.

# ----- API Configuration -----
# Khong them hau to /api/v1 (lib/api.ts tu ghep /api/v1/...).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Dia chi backend noi bo (dung trong Docker: http://backend:8000).
BACKEND_INTERNAL_URL=http://localhost:8000

# ----- NextAuth Configuration -----
NEXTAUTH_URL=http://localhost:3000
# BAT BUOC doi khi trien khai thuc te. Sinh chuoi:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# ----- OAuth Providers (optional) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- Cloudinary (for media uploads) -----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- Feature Flags -----
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_VIDEO_NOTES=true

# ----- Supabase Configuration -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
